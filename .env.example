
# LLM used by the investigation agent. Copy this file to .env and fill in the key.
# Get a Gemini key at https://aistudio.google.com (Get API key). Never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: pin a model. Leave empty to auto-select the newest stable Gemini "flash" model.
LLM_MODEL=

# Local application configuration
BIFURA_DATA_DIR=data
BIFURA_LOG_LEVEL=INFO
