
# LLM used by the investigation agent. Copy this file to .env and fill in the key.
# Get a Gemini key at https://aistudio.google.com (Get API key). Never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: pin a Gemini model. Leave empty to use gemini-3.8-flash with automatic fallbacks.
LLM_MODEL=

# Optional, for Chat check: let Bifura check GPT and Claude answers too.
# GPT needs:    pip install openai      Claude needs: pip install anthropic
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Local application configuration
BIFURA_DATA_DIR=data
BIFURA_LOG_LEVEL=INFO
