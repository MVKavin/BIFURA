{
 "about": "Fault-injection library for the practice agent. Each fault is a known bug (code replacement) or environment condition with a ground-truth failure category. Bifura uses the three demo scenarios for live investigations, and every fault family to generate the synthetic, labelled training dataset. Injected copies live only in data/sandbox/runtime/.",
 "faults": [
  {
   "id": "sep_decimal",
   "category": "state_or_dataflow",
   "title": "Thousands separator read as a decimal point",
   "code": [
    {
     "old": "value = int(txt.replace(\",\", \"\"))",
     "new": "value = int(float(txt.replace(\",\", \".\")) * 100)"
    }
   ]
  },
  {
   "id": "sep_split",
   "category": "state_or_dataflow",
   "title": "Number split on the thousands separator",
   "code": [
    {
     "old": "value = int(txt.replace(\",\", \"\"))",
     "new": "value = int(txt.split(\",\")[0])"
    }
   ]
  },
  {
   "id": "unit_scale",
   "category": "state_or_dataflow",
   "title": "Value scaled to the wrong unit",
   "code": [
    {
     "old": "value = int(txt.replace(\",\", \"\"))",
     "new": "value = int(txt.replace(\",\", \"\")) * 1000"
    }
   ]
  },
  {
   "id": "stale_state",
   "category": "state_or_dataflow",
   "title": "Stale cached revenue reused instead of the extracted value",
   "code": [
    {
     "old": "state[\"revenue\"] = value",
     "new": "state[\"revenue\"] = env.get(\"cached_revenue\", value)"
    }
   ]
  },
  {
   "id": "swapped_args",
   "category": "tool_input_validation",
   "title": "calc_growth called with current and previous swapped",
   "code": [
    {
     "old": "args = {\"current\": state[\"revenue\"], \"previous\": state[\"prev_revenue\"]}",
     "new": "args = {\"current\": state[\"prev_revenue\"], \"previous\": state[\"revenue\"]}"
    }
   ]
  },
  {
   "id": "string_arg",
   "category": "tool_input_validation",
   "title": "calc_growth given a string instead of a number",
   "code": [
    {
     "old": "args = {\"current\": state[\"revenue\"], \"previous\": state[\"prev_revenue\"]}",
     "new": "args = {\"current\": str(state[\"revenue\"]), \"previous\": state[\"prev_revenue\"]}"
    }
   ]
  },
  {
   "id": "wrong_url",
   "category": "tool_input_validation",
